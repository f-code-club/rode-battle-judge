  "query": "\n            SELECT\n                COALESCE(\n                    (\n                        SELECT ARRAY_AGG(pl.language)\n                        FROM problem_languages pl\n                        WHERE pl.problem_id = $1\n                    ),\n                    ARRAY[]::language[]\n                ) as \"languages!:_\",\n                content,\n                checker_language as \"checker_language:_\",\n                checker_path,\n                time_limit,\n                memory_limit,\n                (\n                    SELECT ARRAY_AGG(t.input_path)\n                    FROM test_cases t\n                    WHERE t.problem_id = $1\n                ) as test_cases\n            FROM problems\n            WHERE id = $1\n        ",
